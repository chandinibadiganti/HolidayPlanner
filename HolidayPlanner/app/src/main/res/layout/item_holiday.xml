<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- Formatted Date -->
            <TextView
                android:id="@+id/tvHolidayDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="Mon, 26 Jan 2026" />

            <!-- Long Weekend Badge -->
            <TextView
                android:id="@+id/tvLongWeekendBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_check"
                android:backgroundTint="@color/badge_long_weekend_bg"
                android:textColor="@color/badge_long_weekend_text"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Fri–Sun (3 days)" />
        </LinearLayout>

        <!-- Primary Holiday Name (English or Main) -->
        <TextView
            android:id="@+id/tvHolidayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Republic Day" />

        <!-- Local Holiday Name (hidden if identical) -->
        <TextView
            android:id="@+id/tvHolidayLocalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="2dp"
            tools:text="Gantantra Diwas" />

        <!-- Leave Overlap Indicator -->
        <LinearLayout
            android:id="@+id/layoutOverlapIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/ic_warning"
            android:backgroundTint="@color/badge_overlap_bg"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/badge_overlap_text"
                android:contentDescription="@null"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvOverlapText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/badge_overlap_text"
                tools:text="Overlaps your 'Goa Trip' leave" />
        </LinearLayout>

        <!-- Bridge This Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBridgeThis"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/bridge_this"
            app:icon="@drawable/ic_bridge"
            style="@style/Widget.Material3.Button.TextButton"
            android:padding="0dp"
            android:minWidth="0dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
